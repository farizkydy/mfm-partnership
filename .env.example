# Copy to .env.local for local dev; set the same names in Vercel > Project > Settings > Environment Variables.
RESEND_API_KEY=
# Where inquiries are delivered (defaults to mad.natasya@gmail.com)
INQUIRY_TO_EMAIL=mad.natasya@gmail.com
# Sender. Until a domain is verified in Resend, use onboarding@resend.dev
# (it can only deliver to the email address of the Resend account owner).
INQUIRY_FROM_EMAIL=Mad For Makeup Partnerships <onboarding@resend.dev>
